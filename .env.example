# Email Delivery Configuration (for signup verification codes & forgot password reset emails)
# Recommended for PythonAnywhere Free Tier: Brevo (free 300 emails/day, no credit card required)
# Sign up at https://www.brevo.com -> SMTP & API -> API Keys -> Generate a new API key
BREVO_API_KEY=your_brevo_api_key_here
EMAIL_FROM=your_verified_sender_email@gmail.com
EMAIL_FROM_NAME=Ivris

# Alternative HTTP API providers (also whitelisted on PythonAnywhere Free Tier):
# RESEND_API_KEY=re_...
# SENDGRID_API_KEY=SG....

# Or standard SMTP (for local testing / Gmail App Password):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password
